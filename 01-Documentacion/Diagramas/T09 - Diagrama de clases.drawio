        <mxCell id="e12d" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e12"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
